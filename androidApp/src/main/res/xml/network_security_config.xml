<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. The NAS should present a real certificate (Let's Encrypt via DSM, or Tailscale HTTPS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
