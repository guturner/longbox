# Non-secret settings for the Longbox server on the NAS. Secrets live in /volume1/docker/longbox/secrets.
METRON_USERNAME=your-metron-username
METRON_USER_AGENT=Longbox/0.1 (contact: you@example.com)
GOOGLE_CLIENT_IDS=xxxx-android.apps.googleusercontent.com,xxxx-desktop.apps.googleusercontent.com,xxxx-web.apps.googleusercontent.com
ALLOWED_GOOGLE_EMAILS=you@gmail.com
