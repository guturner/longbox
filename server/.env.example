# Copy to .env (git-ignored) or set these in your host's secret manager. Never commit real values.
PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/longbox
DATABASE_USER=longbox
DATABASE_PASSWORD=change-me

# Free account at https://metron.cloud — used only by the server, never shipped in clients.
METRON_USERNAME=
METRON_PASSWORD=
METRON_USER_AGENT=Longbox/0.1 (contact: you@example.com)

# OAuth client ids from Google Cloud Console (Android, Desktop and Web clients), comma-separated.
GOOGLE_CLIENT_IDS=
# Single-user server: only these verified Google accounts can sign in.
ALLOWED_GOOGLE_EMAILS=you@gmail.com

# Only for local development when the web app runs on a different origin.
WEB_ORIGINS=http://localhost:8081
# Directory containing the built web app (webApp/build/dist/wasmJs/productionExecutable).
WEB_DIST_DIR=
BEHIND_PROXY=false
